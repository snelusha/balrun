{
	"name": "@snelusha/balrun",
	"version": "0.6.3",
	"description": "Run Ballerina anywhere!",
	"keywords": [
		"ballerina",
		"cli",
		"interpreter",
		"runtime",
		"typescript",
		"wasm",
		"webassembly"
	],
	"bugs": {
		"url": "https://github.com/snelusha/balrun/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Sithija Nelusha Silva",
		"email": "hello@snelusha.dev",
		"url": "https://snelusha.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/snelusha/balrun.git",
		"directory": "packages/balrun"
	},
	"bin": {
		"balrun": "./bin/cli.mjs"
	},
	"files": [
		"bin",
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"./dist/wasm_exec-*.mjs"
	],
	"types": "./dist/node.d.mts",
	"exports": {
		".": {
			"node": {
				"types": "./dist/node.d.mts",
				"default": "./dist/node.mjs"
			},
			"default": {
				"types": "./dist/web.d.mts",
				"default": "./dist/web.mjs"
			}
		},
		"./node": {
			"types": "./dist/node.d.mts",
			"default": "./dist/node.mjs"
		},
		"./web": {
			"types": "./dist/web.d.mts",
			"default": "./dist/web.mjs"
		},
		"./react": {
			"types": "./dist/react.d.mts",
			"default": "./dist/react.mjs"
		},
		"./fs/node": {
			"types": "./dist/node.d.mts",
			"default": "./dist/node.mjs"
		},
		"./ballerina.wasm": "./dist/ballerina.wasm",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "bun test --isolate",
		"test:browser": "bun test ./tests/browser/opfs.ts",
		"typecheck": "bun check",
		"clean": "git clean -xdf .turbo dist"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"happy-dom": "^20.14.5",
		"playwright": "1.65.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:",
		"unrun": "^0.3.0"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
