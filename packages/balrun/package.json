{
	"name": "@snelusha/balrun",
	"version": "0.6.1",
	"description": "Run Ballerina anywhere!",
	"keywords": [
		"ballerina",
		"cli",
		"interpreter",
		"runtime",
		"typescript",
		"wasm",
		"webassembly"
	],
	"bugs": {
		"url": "https://github.com/snelusha/balrun/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Sithija Nelusha Silva",
		"email": "hello@snelusha.dev",
		"url": "https://snelusha.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/snelusha/balrun.git",
		"directory": "packages/balrun"
	},
	"bin": {
		"balrun": "./bin/cli.mjs"
	},
	"files": [
		"bin",
		"dist"
	],
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./fs/node": {
			"types": "./dist/fs/node.d.mts",
			"import": "./dist/fs/node.mjs",
			"default": "./dist/fs/node.mjs"
		},
		"./react": {
			"types": "./dist/react.d.mts",
			"import": "./dist/react.mjs",
			"default": "./dist/react.mjs"
		}
	},
	"scripts": {
		"build": "tsdown && cp ../ballerina-wasm/dist/ballerina.wasm dist/ballerina.wasm",
		"test": "bun test",
		"clean": "git clean -xdf .turbo dist"
	},
	"devDependencies": {
		"@types/bun": "^1.3.11",
		"@types/node": "^25.9.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"happy-dom": "^20.11.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"unrun": "^0.3.0"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
