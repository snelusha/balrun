{
  "name": "root",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "examples/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "build:balrun": "turbo run build --filter=@snelusha/balrun",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "clean": "git clean -xdf node_modules",
    "clean:workspace": "turbo run clean"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/semver": "^7.7.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "semver": "^7.8.1",
    "turbo": "^2.9.16"
  },
  "packageManager": "bun@1.3.12"
}
