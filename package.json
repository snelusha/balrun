{
	"name": "root",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"examples/*",
			"packages/*"
		]
	},
	"packageManager": "bun@1.3.12",
	"scripts": {
		"build": "turbo run build",
		"build:balrun": "turbo run build --filter=@snelusha/balrun",
		"test": "turbo run test",
		"format": "biome format . --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --fix",
		"clean": "git clean -xdf node_modules",
		"clean:workspace": "turbo run clean"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/bun": "^1.3.14",
		"@types/semver": "^7.7.1",
		"semver": "^7.8.1",
		"turbo": "^2.9.16"
	}
}
