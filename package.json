{
	"name": "root",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"examples/*",
			"packages/*"
		]
	},
	"scripts": {
		"build": "turbo run build --filter=!ballerina",
		"build:balrun": "turbo run build --filter=@snelusha/balrun",
		"test": "turbo run test --filter=!ballerina --filter=!go-workspace",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"clean": "git clean -xdf node_modules",
		"clean:workspace": "turbo run clean"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/semver": "^7.8.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"semver": "^7.8.5",
		"turbo": "^2.10.13-canary.4"
	},
	"packageManager": "bun@1.3.12"
}
