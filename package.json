{
	"name": "root",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"examples/*",
			"packages/*"
		]
	},
	"scripts": {
		"build": "turbo run build",
		"build:balrun": "turbo run build --filter=@snelusha/balrun",
		"test": "turbo run test",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"clean": "git clean -xdf node_modules",
		"clean:workspace": "turbo run clean"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/semver": "^7.8.0",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"semver": "^7.8.5",
		"turbo": "^2.11.2"
	},
	"packageManager": "bun@1.4.2",
	"catalog": {
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	}
}
