{
	"name": "root",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"examples/*",
			"packages/*"
		]
	},
	"scripts": {
		"build": "turbo run build",
		"build:balrun": "turbo run build --filter=@snelusha/balrun",
		"test": "turbo run test",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"clean": "git clean -xdf node_modules",
		"clean:workspace": "turbo run clean"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/semver": "^7.8.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"semver": "^7.8.5",
		"turbo": "^2.10.11"
	},
	"packageManager": "bun@1.3.12",
	"catalog": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.6.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^7.0.2"
	}
}
