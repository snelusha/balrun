{
	"$schema": "https://turbo.build/schema.json",
	"futureFlags": {
		"experimentalGoWorkspaces": true,
		"experimentalTaskCommand": true
	},
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"clean": {
			"cache": false
		}
	}
}
